digraph ClassDiagram {
    graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.45, ranksep=0.5];
    node [shape=record, style="filled", fontname="Calibri", fontsize=10, color="#1B4F72", fillcolor="#EBF5FB"];
    edge [fontname="Calibri", fontsize=9, color="#2C3E50"];

    Warehouse [label="{Warehouse\n(Складской комплекс / Агрегат)|- inventory : Map\<String, StockItem\>\l- auditLog : List\<StockMovement\>\l|+ addItem(StockItem) : void\l+ receive(String, int) : void\l+ issue(String, int) : void\l+ findByCategory(Category) : List\<StockItem\>\l+ totalsByCategory() : Map\<Category, Integer\>\l+ addTotalQuantity() : int\l+ addTotalQuantity(Warehouse) : int\l- findExistingItemOrThrow(String) : StockItem\l+ getItem(String) : StockItem\l+ itemsCount() : int\l+ movementsCount() : int\l+ getAllItems() : List\<StockItem\>\l+ getAllMovements() : List\<StockMovement\>\l}"];

    StockItem [label="{StockItem\n(Номенклатурная единица)|+ MIN_RESERVE_THRESHOLD : int = 10\l- code : String\l- name : String\l- category : Category\l- quantity : int\l|+ StockItem(String, String, Category, int)\l- validateAttributes(...) : void\l+ increase(int) : void\l+ decrease(int) : void\l+ getCode() : String\l+ getName() : String\l+ getCategory() : Category\l+ getQuantity() : int\l+ equals(Object) : boolean\l+ hashCode() : int\l+ toString() : String\l}"];

    StockMovement [label="{«record»\nStockMovement\n(Ордер перемещения)|- itemCode : String\l- type : MovementType\l- quantity : int\l|+ StockMovement(String, MovementType, int)\l+ itemCode() : String\l+ type() : MovementType\l+ quantity() : int\l}"];

    Category [label="{«enum»\nCategory||COMPUTER\lDISPLAY\lPERIPHERAL\lNETWORK\l}", fillcolor="#FEF9E7", color="#B7950B"];

    MovementType [label="{«enum»\nMovementType||RECEIVE\lISSUE\l}", fillcolor="#FEF9E7", color="#B7950B"];

    SelfCheck [label="{SelfCheck\n(Стенд тестирования и верификации)|- testsPassed : int\l- testsFailed : int\l|+ main(String[]) : void\l- executeUnitVerificationSuite() : void\l- executeDataDrivenTestPipeline() : void\l- startInteractiveConsole() : void\l}", fillcolor="#E8F8F5", color="#117864"];

    Warehouse -> StockItem [label="inventory\n0..*", arrowhead=diamond, dir=back];
    Warehouse -> StockMovement [label="auditLog\n0..*", arrowhead=diamond, dir=back];
    StockItem -> Category [label="category\n1", style=dashed, arrowhead=open];
    StockMovement -> MovementType [label="type\n1", style=dashed, arrowhead=open];
    SelfCheck -> Warehouse [label="verifies", style=dashed, arrowhead=open];
    SelfCheck -> StockItem [label="tests", style=dashed, arrowhead=open];
}
